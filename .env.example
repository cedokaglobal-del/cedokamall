# =============================================================================
# SECURITY BOUNDARY
#
# Anything prefixed VITE_ is injected into the browser bundle at build time and
# is therefore PUBLIC. Never put a secret behind a VITE_ prefix.
#
# The following are SERVER-ONLY. Set them in the Vercel dashboard
# (Settings > Environment Variables), not in this file, and never prefix them:
#
#   SUPABASE_URL                 public value, but keep it here for the functions
#   SUPABASE_SERVICE_ROLE_KEY    SECRET - bypasses row level security
#   PAYSTACK_SECRET_KEY          SECRET - can move real money
#   SITE_URL                     used for the same-origin check on /api routes
#
# The Supabase anon key in VITE_SUPABASE_ANON_KEY is designed to be public; what
# protects your data is the row level security policies in SECURITY_HARDENING.sql.
# =============================================================================

# Cedokamall Environment Configuration
# Copy this file to .env.local and update with your actual values

# Server Configuration
VITE_API_URL=http://localhost:3000
VITE_APP_NAME=Cedokamall
VITE_APP_VERSION=1.0.0

# Development
VITE_DEV_PORT=8080
VITE_ENV=development

# Supabase (PUBLIC - safe to expose, access is governed by RLS policies)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_PRODUCT_BUCKET=product-images

# Admin Configuration
VITE_ADMIN_EMAILS=admin@example.com
VITE_ADMIN_EMAIL=admin@example.com
VITE_WHATSAPP_NUMBER=2349128817136

# Feature Flags
VITE_ENABLE_FLASH_DEALS=true
VITE_ENABLE_LOYALTY_PROGRAM=true
VITE_ENABLE_SPIN_WHEEL=false

# Site URL
VITE_SITE_URL=https://cedokamall.com

# API Keys (for external services)
VITE_GOOGLE_ANALYTICS_ID=G-6KG0L3JXPM
VITE_SENTRY_DSN=

# Security
VITE_SESSION_TIMEOUT=3600000
VITE_TOKEN_EXPIRY=86400000
